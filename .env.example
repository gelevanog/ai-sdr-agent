# Copy to .env and adjust. Every variable is optional; the defaults run the demo with the offline model.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---------------------------------------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------------------------------------
# fake (offline, rule-based), openrouter, qwen, openai, anthropic
SCOUT_LLM_PROVIDER=fake
# Empty = the provider's default (openrouter: nvidia/nemotron-3-super-120b-a12b:free).
SCOUT_LLM_MODEL=
SCOUT_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# Refuse any OpenRouter model id that does not end in ":free", paid plugins and answers served by paid models.
SCOUT_REQUIRE_FREE_MODELS=true
# A different free model for the evaluation's independent claim audit and blind preference judge.
SCOUT_JUDGE_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=
# Qwen Cloud (DashScope / Model Studio, OpenAI-compatible). DASHSCOPE_API_KEY also works.
QWEN_API_KEY=
SCOUT_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SCOUT_ANTHROPIC_EFFORT=low
SCOUT_LLM_REASONING_EFFORT=low
SCOUT_LLM_MAX_TOKENS=16000

# Budget for real API calls: disk cache, one request per N seconds, retries, a hard cap and a JSONL ledger.
SCOUT_LLM_CACHE=true
SCOUT_LLM_CACHE_DIR=.cache/llm
SCOUT_LLM_LEDGER=results/calls.jsonl
SCOUT_LLM_MAX_CALLS=495
SCOUT_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3
SCOUT_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------------------------------------
# Storage, ICP and the synthetic web
# ---------------------------------------------------------------------------------------------------------
SCOUT_DATABASE_URL=postgresql://scout:scout@localhost:5432/scout
SCOUT_ICP_FILE=configs/icp.yaml
SCOUT_COMPANIES_FILE=data/companies.yaml
# On API start: generate the synthetic web and load the demo accounts when the database is empty.
SCOUT_SEED_DEMO=true
# auto = queue the pipeline for the demo accounts only with the offline model; always; never.
SCOUT_SEED_PIPELINE=auto
SCOUT_DEMO_SEED=7
SCOUT_SYNTHETIC_WEB_DIR=data/synthetic_web
# Fetch the synthetic sites from a static server instead of the disk (docker compose sets this).
SCOUT_SYNTHETIC_WEB_URL=
SCOUT_SYNTHETIC_WEB_PUBLIC_URL=http://localhost:8090
# The date research treats as today (signal freshness on the synthetic web). Empty = the real date.
SCOUT_TODAY=2026-10-01

# ---------------------------------------------------------------------------------------------------------
# Research and drafting
# ---------------------------------------------------------------------------------------------------------
# synthetic or live (your own target list: public company pages only, robots.txt, rate limited).
SCOUT_CRAWL_MODE=synthetic
SCOUT_CRAWL_MAX_PAGES=12
SCOUT_CRAWL_MIN_SECONDS_PER_DOMAIN=2
SCOUT_CRAWL_USER_AGENT="ScoutResearchBot/0.1 (+https://github.com/gelevanog/ai-sdr-agent; company pages only)"
SCOUT_INJECTION_GUARD=true
SCOUT_LLM_JUDGMENT=true
SCOUT_CLAIM_CHECKER=true
SCOUT_MAX_REGENERATIONS=2
SCOUT_DRAFT_VARIANTS=2

# ---------------------------------------------------------------------------------------------------------
# Sending (capture only) and compliance
# ---------------------------------------------------------------------------------------------------------
SCOUT_SMTP_HOST=localhost
SCOUT_SMTP_PORT=1025
SCOUT_FROM_ADDRESS="Dana Whitfield <dana@wayline.example>"
# Base URL of the API for one-click unsubscribe links (/u/<token>).
SCOUT_PUBLIC_URL=http://localhost:8000
SCOUT_DAILY_SEND_CAP=40
SCOUT_PER_DOMAIN_DAILY_CAP=2
SCOUT_BUSINESS_HOURS_START=9
SCOUT_BUSINESS_HOURS_END=17
SCOUT_FOLLOWUP_BUSINESS_DAYS=3,7
SCOUT_RETENTION_DAYS_PAGES=30
SCOUT_RETENTION_DAYS_REPLIES=180
SCOUT_RETENTION_DAYS_REJECTED_DRAFTS=30
SCOUT_REVIEWER_NAME=reviewer

# ---------------------------------------------------------------------------------------------------------
# CRM
# ---------------------------------------------------------------------------------------------------------
# off, mock (an in-process HubSpot stand-in), hubspot (a private app token with CRM object write scopes)
SCOUT_CRM_MODE=mock
SCOUT_HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TOKEN=

# ---------------------------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------------------------
SCOUT_CORS_ORIGINS=http://localhost:3000
